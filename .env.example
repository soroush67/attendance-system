# Safe example only; do not commit real passwords or tokens.
POSTGRES_DB=attendance
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Alternatively provide DATABASE_URL with a URL-encoded password.
# DATABASE_URL=postgresql+psycopg://attendance_app:<PASSWORD>@<HOST>:5432/attendance
PIP_INDEX_URL=https://nexus.hamainsurance.net/repository/py-proxy/simple
POSTGRES_USER=attendance_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD
BIND_IP=127.0.0.1
WEB_PORT=8080
SESSION_HTTPS_ONLY=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
DEVICE_FORMAT=auto
DEVICE_TIMEZONE=Asia/Tehran

# Development defaults for shared PostgreSQL-backed login protection.
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
LOGIN_ACCOUNT_FAILURES=5
LOGIN_IP_FAILURES=30
LOGIN_COUNTER_RETENTION_DAYS=7
